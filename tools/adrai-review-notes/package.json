{
  "name": "adrai-review-notes",
  "displayName": "adrAI Review Notes",
  "description": "Personal annotation layer for adrAI artifact review with debate promotion",
  "version": "0.1.1",
  "publisher": "sprantic",
  "author": {
    "name": "sprantic"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sprantic/adrai"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e3a5f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "review",
    "notes",
    "annotation",
    "debate",
    "adrAI",
    "AIDE"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:adraiReviewNotes",
    "onCommand:adrai.addNote",
    "onCommand:adrai.showPanel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "adrai-review-notes",
          "title": "Review Notes",
          "icon": "media/icons/review-notes.svg"
        }
      ]
    },
    "views": {
      "adrai-review-notes": [
        {
          "id": "adraiReviewNotes",
          "name": "Review Notes",
          "icon": "media/icons/review-notes.svg",
          "contextualTitle": "adrAI Review Notes"
        }
      ]
    },
    "commands": [
      {
        "command": "adrai.addNote",
        "title": "adrAI: Add Review Note",
        "icon": "$(add)"
      },
      {
        "command": "adrai.addLocation",
        "title": "adrAI: Add Location to Note",
        "icon": "$(link)"
      },
      {
        "command": "adrai.showPanel",
        "title": "adrAI: Toggle Review Notes Panel"
      },
      {
        "command": "adrai.promoteToDebate",
        "title": "adrAI: Promote to Debate",
        "icon": "$(rocket)"
      },
      {
        "command": "adrai.resolveNote",
        "title": "adrAI: Resolve Note",
        "icon": "$(check)"
      },
      {
        "command": "adrai.editNote",
        "title": "adrAI: Edit Note",
        "icon": "$(edit)"
      },
      {
        "command": "adrai.deleteNote",
        "title": "adrAI: Delete Note",
        "icon": "$(trash)"
      },
      {
        "command": "adrai.refreshNotes",
        "title": "adrAI: Refresh Notes",
        "icon": "$(refresh)"
      },
      {
        "command": "adrai.goToLocation",
        "title": "adrAI: Go to Location"
      }
    ],
    "keybindings": [
      {
        "command": "adrai.addNote",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "editorTextFocus"
      },
      {
        "command": "adrai.addLocation",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "adrai.showPanel",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "adrai.addNote",
          "when": "view == adraiReviewNotes",
          "group": "navigation"
        },
        {
          "command": "adrai.refreshNotes",
          "when": "view == adraiReviewNotes",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "adrai.addLocation",
          "when": "view == adraiReviewNotes && viewItem == note",
          "group": "inline"
        },
        {
          "command": "adrai.promoteToDebate",
          "when": "view == adraiReviewNotes && viewItem == note",
          "group": "1_actions"
        },
        {
          "command": "adrai.resolveNote",
          "when": "view == adraiReviewNotes && viewItem == note",
          "group": "1_actions"
        },
        {
          "command": "adrai.editNote",
          "when": "view == adraiReviewNotes && viewItem == note",
          "group": "2_edit"
        },
        {
          "command": "adrai.deleteNote",
          "when": "view == adraiReviewNotes && viewItem == note",
          "group": "3_delete"
        },
        {
          "command": "adrai.goToLocation",
          "when": "view == adraiReviewNotes && viewItem == location",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "adrai.addNote",
          "group": "adrai",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "title": "adrAI Review Notes",
      "properties": {
        "adrai.storageLocation": {
          "type": "string",
          "default": "~/.adrai/review-notes.yaml",
          "description": "Path to the review notes YAML file"
        },
        "adrai.debateTemplateDir": {
          "type": "string",
          "default": "docs/debates/templates",
          "description": "Path to debate templates directory relative to workspace"
        },
        "adrai.debatesDir": {
          "type": "string",
          "default": "docs/debates",
          "description": "Path to debates directory relative to workspace"
        },
        "adrai.groupBy": {
          "type": "string",
          "enum": ["status", "type", "file"],
          "default": "status",
          "description": "How to group notes in the panel"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "bun run compile",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "yaml": "^2.3.4",
    "uuid": "^9.0.1"
  }
}
